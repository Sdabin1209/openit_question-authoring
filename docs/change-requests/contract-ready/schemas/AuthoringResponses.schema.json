{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AuthoringResponses.schema.json",
  "title": "AuthoringResponses",
  "description": "question-authoring 저작 API 응답 본문(JSON). question-authoring -> 호출자. 실패는 계약의 BoundaryError 레코드이고 여기에 없다. 읽는 쪽은 모르는 키를 무시해도 되지만(응답은 서버가 정한다) 이 스키마는 서버가 내는 키를 모두 열거해 additionalProperties:false로 닫는다: 서버가 키를 늘리면 시험이 먼저 깨져 스키마 갱신을 강제한다. draft.bank는 문진 스키마 QuestionBank(version 없는 초안 모양)이며 여기서는 object로만 보고, 확정 시 QuestionBank 스키마로 검증된다.",
  "$defs": {
    "Flag": {
      "type": "object",
      "required": [
        "flag_id",
        "path",
        "kind",
        "message",
        "raw",
        "resolved"
      ],
      "additionalProperties": false,
      "properties": {
        "flag_id": {
          "type": "string",
          "pattern": "^fl-[0-9a-f]+(-[0-9]+)?$"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "kind": {
          "enum": [
            "MISSING",
            "UNPARSED",
            "UNSURE"
          ]
        },
        "message": {
          "type": "string"
        },
        "raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved": {
          "type": "boolean"
        },
        "resolved_by": {
          "$ref": "_common.schema.json#/$defs/Id"
        },
        "resolution": {
          "enum": [
            "ACKNOWLEDGED",
            "EDITED"
          ]
        }
      }
    },
    "MaterialIngested": {
      "description": "POST /v1/materials 성공. status=FALLBACK이면 읽지 못해 빈 초안이 만들어졌고 reason이 있다",
      "type": "object",
      "required": [
        "draft_id",
        "status",
        "warnings"
      ],
      "additionalProperties": false,
      "properties": {
        "draft_id": {
          "$ref": "_common.schema.json#/$defs/Id"
        },
        "status": {
          "enum": [
            "PARSED",
            "FALLBACK"
          ]
        },
        "open_flags": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PARSED"
              }
            }
          },
          "then": {
            "required": [
              "open_flags"
            ]
          },
          "else": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "Draft": {
      "description": "초안 하나. POST /v1/drafts, GET /v1/drafts/{id}, edits, acknowledge, discard의 응답",
      "type": "object",
      "required": [
        "draft_id",
        "question_set_id",
        "status",
        "base",
        "bank",
        "flags",
        "source",
        "fallback",
        "warnings",
        "created_by",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "draft_id": {
          "$ref": "_common.schema.json#/$defs/Id"
        },
        "question_set_id": {
          "$ref": "_common.schema.json#/$defs/Id"
        },
        "status": {
          "enum": [
            "OPEN",
            "CONFIRMED",
            "DISCARDED"
          ]
        },
        "base": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "id",
                "version",
                "content_hash"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "_common.schema.json#/$defs/Id"
                },
                "version": {
                  "$ref": "_common.schema.json#/$defs/Id"
                },
                "content_hash": {
                  "$ref": "_common.schema.json#/$defs/Hash"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "bank": {
          "type": "object"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "flag_id",
              "path",
              "kind",
              "message",
              "raw",
              "resolved"
            ],
            "additionalProperties": false,
            "properties": {
              "flag_id": {
                "type": "string",
                "pattern": "^fl-[0-9a-f]+(-[0-9]+)?$"
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "kind": {
                "enum": [
                  "MISSING",
                  "UNPARSED",
                  "UNSURE"
                ]
              },
              "message": {
                "type": "string"
              },
              "raw": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "resolved": {
                "type": "boolean"
              },
              "resolved_by": {
                "$ref": "_common.schema.json#/$defs/Id"
              },
              "resolution": {
                "enum": [
                  "ACKNOWLEDGED",
                  "EDITED"
                ]
              }
            }
          }
        },
        "source": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "screen"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "kind",
                    "source_hash",
                    "filename",
                    "size"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "material"
                    },
                    "source_hash": {
                      "$ref": "_common.schema.json#/$defs/Hash"
                    },
                    "filename": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "extractor": {
                      "type": "string"
                    },
                    "extractor_version": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "fallback": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "reason"
              ],
              "additionalProperties": false,
              "properties": {
                "reason": {
                  "type": "string"
                },
                "guidance": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_by": {
          "$ref": "_common.schema.json#/$defs/Id"
        },
        "created_at": {
          "$ref": "_common.schema.json#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "_common.schema.json#/$defs/Timestamp"
        },
        "confirmed": {
          "type": "object",
          "required": [
            "ref",
            "preview_hash",
            "review_id"
          ],
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "object",
              "required": [
                "id",
                "version",
                "content_hash"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "_common.schema.json#/$defs/Id"
                },
                "version": {
                  "$ref": "_common.schema.json#/$defs/Id"
                },
                "content_hash": {
                  "$ref": "_common.schema.json#/$defs/Hash"
                }
              }
            },
            "preview_hash": {
              "$ref": "_common.schema.json#/$defs/Hash"
            },
            "review_id": {
              "$ref": "_common.schema.json#/$defs/Id"
            }
          }
        },
        "confirming": {
          "type": "object",
          "description": "확정 중 예약된 번호와 시각(재시도가 같은 버전을 내려는 것)",
          "required": [
            "version",
            "at"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "integer"
            },
            "at": {
              "$ref": "_common.schema.json#/$defs/Timestamp"
            }
          }
        },
        "discard_reason": {
          "type": "string"
        },
        "discarded_by": {
          "$ref": "_common.schema.json#/$defs/Id"
        }
      }
    },
    "DraftList": {
      "description": "GET /v1/drafts",
      "type": "object",
      "required": [
        "drafts"
      ],
      "additionalProperties": false,
      "properties": {
        "drafts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Draft"
          }
        }
      }
    },
    "Preview": {
      "description": "GET /v1/drafts/{id}/preview. preview_hash를 confirm에 돌려보낸다. 저자가 이 text를 읽고 확인한다",
      "type": "object",
      "required": [
        "draft_id",
        "status",
        "preview_hash",
        "text",
        "open_flags",
        "validation_errors",
        "change",
        "warnings",
        "fallback",
        "ready_to_confirm"
      ],
      "additionalProperties": false,
      "properties": {
        "draft_id": {
          "$ref": "_common.schema.json#/$defs/Id"
        },
        "status": {
          "enum": [
            "OPEN",
            "CONFIRMED",
            "DISCARDED"
          ]
        },
        "preview_hash": {
          "$ref": "_common.schema.json#/$defs/Hash"
        },
        "text": {
          "type": "string"
        },
        "open_flags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "flag_id",
              "path",
              "kind",
              "message",
              "raw",
              "resolved"
            ],
            "additionalProperties": false,
            "properties": {
              "flag_id": {
                "type": "string",
                "pattern": "^fl-[0-9a-f]+(-[0-9]+)?$"
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "kind": {
                "enum": [
                  "MISSING",
                  "UNPARSED",
                  "UNSURE"
                ]
              },
              "message": {
                "type": "string"
              },
              "raw": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "resolved": {
                "type": "boolean"
              },
              "resolved_by": {
                "$ref": "_common.schema.json#/$defs/Id"
              },
              "resolution": {
                "enum": [
                  "ACKNOWLEDGED",
                  "EDITED"
                ]
              }
            }
          }
        },
        "validation_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "change": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "change_kinds",
                "affected_slots",
                "follow_ups",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "change_kinds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "affected_slots": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "follow_ups": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "text": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fallback": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ]
        },
        "ready_to_confirm": {
          "type": "boolean"
        }
      }
    },
    "ConfirmResponse": {
      "description": "POST /v1/drafts/{id}/confirm = 만들어진 버전의 Ref(계약 ArtifactRef 모양). 같은 preview_hash로 다시 부르면 같은 Ref(멱등)",
      "$ref": "_common.schema.json#/$defs/ArtifactRef"
    },
    "AddReviewResponse": {
      "description": "POST /v1/reviews = 만들어진 계약 ReviewRecord(영역 사본 없이 계약 스키마를 그대로 쓴다)",
      "$ref": "ReviewRecord.schema.json"
    }
  }
}
