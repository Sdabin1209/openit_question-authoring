{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SignalsResponse.schema.json",
  "title": "SignalsResponse",
  "description": "GET /v1/signals 응답. question-authoring -> 저자(콘솔). ops-feedback의 I7 실패 사례에서 만든 읽기 전용 신호. 발화 문장·trace 본문은 담지 않는다. 불변식: cases_read = 읽은 사례 수(필터 전), 문항 세트 case_count의 합 + skipped.NO_QUESTION_SET <= cases_read, confirmed_count <= case_count.",
  "oneOf": [
    {
      "title": "Disabled",
      "type": "object",
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "DISABLED"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    {
      "title": "Ok",
      "type": "object",
      "required": [
        "status",
        "generated_at",
        "cases_read",
        "truncated",
        "confusion_min",
        "question_sets",
        "skipped",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "OK"
        },
        "generated_at": {
          "$ref": "_common.schema.json#/$defs/Timestamp"
        },
        "cases_read": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "confusion_min": {
          "type": "integer",
          "minimum": 1
        },
        "question_sets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "question_set_id",
              "case_count",
              "confirmed_count",
              "failure_types",
              "versions",
              "questions"
            ],
            "additionalProperties": false,
            "properties": {
              "question_set_id": {
                "$ref": "_common.schema.json#/$defs/Id"
              },
              "case_count": {
                "type": "integer",
                "minimum": 0
              },
              "confirmed_count": {
                "type": "integer",
                "minimum": 0
              },
              "failure_types": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "versions": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "questions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "question_id",
                    "case_count",
                    "confirmed_count",
                    "failure_types",
                    "confusions"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "question_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "case_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "confirmed_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "failure_types": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "confusions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "failure_type",
                          "count"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "failure_type": {
                            "type": "string"
                          },
                          "count": {
                            "type": "integer",
                            "minimum": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "skipped": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "NO_QUESTION_SET",
              "NO_QUESTION_ID",
              "TRACE_UNREADABLE"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "note": {
          "type": "string"
        }
      }
    }
  ]
}
