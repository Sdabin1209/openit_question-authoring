{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.example/question-authoring/ext-question-authoring.schema.json",
  "title": "ReviewRecord.ext[\"question-authoring\"]와 ChangeClassification.ext[\"question-authoring\"]",
  "description": "question-authoring이 쓰고, 게이트·합성 데이터·콘솔이 읽는다(보존하되 판단에 쓰지 않는다: 계약 ext 규칙). ReviewRecord.ext의 값은 $defs.ReviewExt, ChangeClassification.ext의 값은 $defs.ChangeExt. 모르는 키는 거부한다: 이 값은 임상 근거 승인의 출처 기록이라 조용히 늘어난 키를 허용하지 않는다(키가 늘면 이 스키마를 먼저 올린다).",
  "$defs": {
    "ReviewExt": {
      "oneOf": [
        {
          "title": "AUTHOR_CONFIRMATION",
          "description": "저자의 확인(버전을 태어나게 한 검수). source는 초안의 출처",
          "type": "object",
          "required": [
            "kind",
            "draft_id",
            "preview_hash",
            "source",
            "acknowledged_flags",
            "edited_flags"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "AUTHOR_CONFIRMATION"
            },
            "draft_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "preview_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "source": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "screen"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "kind",
                    "source_hash",
                    "filename",
                    "size"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "material"
                    },
                    "source_hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "filename": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "extractor": {
                      "type": "string"
                    },
                    "extractor_version": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "acknowledged_flags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "edited_flags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "title": "FOLLOW_UP_REVIEW",
          "description": "이후 add_review로 덧붙은 검수",
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "FOLLOW_UP_REVIEW"
            }
          }
        }
      ]
    },
    "ChangeExt": {
      "type": "object",
      "required": [
        "draft_id"
      ],
      "additionalProperties": false,
      "properties": {
        "draft_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "Source": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "screen"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "source_hash",
            "filename",
            "size"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "material"
            },
            "source_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "filename": {
              "type": "string"
            },
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "extractor": {
              "type": "string"
            },
            "extractor_version": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
