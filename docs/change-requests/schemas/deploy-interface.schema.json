{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.example/question-authoring/deploy-interface.schema.json",
  "title": "question-authoring과 deploy의 구성 인터페이스(/readyz 응답, purge 결과, 환경 변수 표)",
  "description": "deploy가 만들고 이 영역이 읽는 것(환경 변수·비밀 파일)과, 이 영역이 내고 deploy가 읽는 것(/readyz 본문, purge 출력). 환경 변수는 문자열로만 온다. 비밀(…_TOKENS, …_DATABASE_URL, …_FAILURES_TOKEN)은 NAME_FILE(파일 경로)로 받는다(D84) - 값은 어떤 응답·로그에도 쓰지 않는다. 모르는 환경 변수는 무시한다(환경에는 이 서비스와 무관한 변수가 항상 섞이므로 거부할 수 없다), 아는 변수의 형식 오류는 기동 거부.",
  "$defs": {
    "ReadyzResponse": {
      "description": "GET /readyz. 200=ready, 503=not-ready(총 2초 안에, CONVENTIONS 상태 확인). 접속 정보 없음",
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ready",
            "not-ready"
          ]
        },
        "db": {
          "enum": [
            "sqlite",
            "postgres"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "enum": [
              "two_person_disabled"
            ]
          }
        }
      }
    },
    "PurgeResult": {
      "description": "python -m question_authoring purge 의 표준 출력 한 줄(파이썬 dict 표기가 아니라 JSON으로 내도록 제안). 종료 코드 0=성공(0건 포함, 멱등), 비0=구성 오류(SystemExit 메시지)",
      "type": "object",
      "required": [
        "drafts_removed",
        "sources_removed"
      ],
      "additionalProperties": false,
      "properties": {
        "drafts_removed": {
          "type": "integer",
          "minimum": 0
        },
        "sources_removed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Environment": {
      "description": "환경 변수(문자열). 비밀 항목은 <NAME>_FILE도 받는다",
      "type": "object",
      "properties": {
        "QA_DEV_MODE": {
          "enum": [
            "1",
            "0",
            "true",
            "false"
          ]
        },
        "QA_DATABASE_URL": {
          "type": "string",
          "description": "비밀. 운영 필수(QA_DEV_MODE 아닐 때)"
        },
        "QA_DB_PATH": {
          "type": "string"
        },
        "QA_AUTHOR_TOKENS": {
          "type": "string",
          "description": "비밀. '토큰:actor-id:역할' 쉼표 목록, 역할은 question-author|clinical-reviewer"
        },
        "QA_READ_TOKENS": {
          "type": "string",
          "description": "비밀. '역할=토큰' 쉼표 목록(I1 읽기 전용)"
        },
        "QA_GATEWAY_TOKENS": {
          "type": "string",
          "description": "비밀. gateway 서비스 토큰 쉼표 목록"
        },
        "QA_USER_ROLES": {
          "type": "string",
          "pattern": "^([^=,]+=(question-author|clinical-reviewer))(,[^=,]+=(question-author|clinical-reviewer))*$",
          "description": "사용자ID=역할 쉼표 목록"
        },
        "QA_FAILURES_URL": {
          "type": "string",
          "format": "uri"
        },
        "QA_FAILURES_TOKEN_ENV": {
          "type": "string"
        },
        "QA_REQUIRE_TWO_PERSON": {
          "enum": [
            "true",
            "false",
            "1",
            "0"
          ]
        },
        "QA_HOST": {
          "type": "string"
        },
        "QA_PORT": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "QA_DRAFT_RETENTION_DAYS": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "QA_SOURCE_RETENTION_DAYS": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "QA_MAX_CONCURRENT_REQUESTS": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "patternProperties": {
        "^QA_.*_SECONDS$": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "0 초과 600 이하(코드가 검사)"
        }
      }
    }
  }
}
