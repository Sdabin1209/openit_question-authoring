{
  "service": "question-authoring",
  "routes": [
    {
      "paths": [
        "/v1/materials",
        "/v1/reviews"
      ],
      "methods": [
        "POST"
      ],
      "auth": {
        "kind": "account",
        "roles": [
          "author",
          "clinical-reviewer"
        ]
      },
      "upstream_token": "qa-gateway-token",
      "user_header": "set",
      "timeouts_ms": {
        "dial": 1000,
        "response_header": 120000
      },
      "max_body_bytes": 8388608
    },
    {
      "paths": [
        "/v1/drafts",
        "/v1/drafts/*"
      ],
      "methods": [
        "GET",
        "POST"
      ],
      "auth": {
        "kind": "account",
        "roles": [
          "author",
          "clinical-reviewer"
        ]
      },
      "upstream_token": "qa-gateway-token",
      "user_header": "set",
      "timeouts_ms": {
        "dial": 1000,
        "response_header": 120000
      }
    },
    {
      "paths": [
        "/v1/signals",
        "/v1/set-versions",
        "/v1/set-decisions"
      ],
      "methods": [
        "GET"
      ],
      "auth": {
        "kind": "account",
        "roles": [
          "author",
          "clinical-reviewer"
        ]
      },
      "upstream_token": "qa-gateway-token",
      "user_header": "set",
      "timeouts_ms": {
        "dial": 1000,
        "response_header": 120000
      }
    },
    {
      "paths": [
        "/ui/",
        "/ui/*"
      ],
      "methods": [
        "GET"
      ],
      "auth": {
        "kind": "authenticated"
      },
      "upstream_token": "qa-gateway-token",
      "user_header": "strip"
    },
    {
      "paths": [
        "/v1/question-sets",
        "/v1/question-sets/*"
      ],
      "auth": {
        "kind": "denied"
      }
    },
    {
      "paths": [
        "/metrics"
      ],
      "auth": {
        "kind": "denied"
      }
    }
  ],
  "egress": [
    "ops-feedback",
    "release-gate",
    "external:backup"
  ]
}
