{
 "$id": "BankValidateInput.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "description": "문항 세트 검증 입력",
 "type": "object",
 "required": [
  "bank",
  "version"
 ],
 "additionalProperties": false,
 "properties": {
  "bank": {
   "type": "object"
  },
  "version": {
   "oneOf": [
    {
     "type": "integer",
     "minimum": 0
    },
    {
     "type": "null"
    }
   ]
  },
  "question_set_id": {
   "oneOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "description": "초안이 속한 문항 세트 ID(I1의 {id}). 주어지면 bank.question_set_id와 같아야 한다"
  }
 },
 "title": "BankValidateInput"
}
