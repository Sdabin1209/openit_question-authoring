{
 "$id": "ConfirmFinalizeInput.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "description": "확인 마무리 입력",
 "type": "object",
 "required": [
  "draft",
  "actor",
  "preview_hash",
  "validation_errors",
  "ref",
  "diff",
  "at",
  "require_two_person",
  "pipeline_schema_version",
  "bank",
  "base_bank"
 ],
 "additionalProperties": false,
 "properties": {
  "draft": {
   "$ref": "AuthoringResponses.schema.json#/$defs/Draft"
  },
  "actor": {
   "$ref": "Actor.json"
  },
  "preview_hash": {
   "$ref": "PreviewHashValue.json"
  },
  "validation_errors": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "ref": {
   "$ref": "_common.schema.json#/$defs/ArtifactRef"
  },
  "diff": {
   "oneOf": [
    {
     "$ref": "ChangeDiff.json"
    },
    {
     "type": "null"
    }
   ]
  },
  "at": {
   "$ref": "_common.schema.json#/$defs/Timestamp"
  },
  "require_two_person": {
   "type": "boolean"
  },
  "pipeline_schema_version": {
   "$ref": "_common.schema.json#/$defs/PipelineSchemaVersion"
  },
  "base_bank": {
   "description": "기반 버전의 문항 세트(QuestionBank 모양). 첫 버전(기반 없음)이면 null. 구조 잠금(U81)의 비교 기준이며 wiring이 저장소에서 읽어 넘긴다",
   "oneOf": [
    {
     "type": "object"
    },
    {
     "type": "null"
    }
   ]
  },
  "bank": {
   "description": "확정 후보 문항 세트(version 포함). 구조 잠금이 base_bank와 비교한다",
   "type": "object"
  }
 },
 "title": "ConfirmFinalizeInput"
}
